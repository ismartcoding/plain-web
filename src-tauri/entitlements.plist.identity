<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Non-sandboxed Developer ID build for direct/website distribution.
         Kept App Sandbox OFF (restricted multicast entitlement excluded) so
         the GitHub release keeps signing/notarizing and can read any user
         path without file-scope entitlements. -->
    <key>com.apple.security.app-sandbox</key>
    <false/>

    <!-- Outgoing TCP/UDP network connections (plain sockets, LAN traffic). -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Incoming TCP/UDP connections (local HTTP/WebSocket proxy listener). -->
    <key>com.apple.security.network.server</key>
    <true/>
</dict>
</plist>