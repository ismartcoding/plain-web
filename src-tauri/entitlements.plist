<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App Sandbox is MANDATORY for Mac App Store distribution.
         Must sign with the App Store ("Mac App Store") cert + a provisioning
         profile that includes the multicast entitlement, or codesign fails. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- Read access to files/folders the user picks via NSOpenPanel or
         <input type=file>. Required for image/media pick + upload
         (plugin-dialog open + plugin-fs readFile). -->
    <key>com.apple.security.files.user-selected.read-only</key>
    <true/>

    <!-- Outgoing TCP/UDP network connections (plain sockets, LAN traffic). -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Incoming TCP/UDP connections (local HTTP/WebSocket proxy listener). -->
    <key>com.apple.security.network.server</key>
    <true/>

    <!-- Restricted entitlement: must be granted by Apple and present in the
         App Store provisioning profile. Already approved for this app.
         Required for UDP multicast (mDNS LAN discovery). -->
    <key>com.apple.developer.networking.multicast</key>
    <true/>

    <!-- Optional, add only if the feature grows: user-selected.read-write
         (writable user-picked files) and bookmarks.app-scope (persist access
         across launches). -->
</dict>
</plist>