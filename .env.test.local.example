# Copy this file to `.env.test.local` and fill in real values.
# `.env.test.local` is gitignored (*.local in .gitignore).
#
# When this file is absent OR any required var is missing, the
# integration test suites skip themselves cleanly (no failures).
# See tests/integration/README.md for setup instructions.

# ── Rust local server (plain-web Tauri desktop) ───────────────────────────
# The local HTTP server started by the Tauri app. Find the port in the
# app's dev console ("local server port: NNNN") or via the `app` GraphQL
# query's `httpPort` field. The token is `app.urlToken`.
RUST_API_URL=http://127.0.0.1:8080
RUST_API_TOKEN=
# Optional: the client_id to send in the `c-id` header. Defaults to
# "integration-test" if unset.
RUST_CLIENT_ID=integration-test

# ── Android device (plain-app) ────────────────────────────────────────────
# The device's HTTPS endpoint (self-signed cert is OK — the test process
# disables TLS rejection). Find the URL from the QR code or the device's
# `app.urlToken` / `app.httpsPort` fields. The token is the device's
# `auth_token` (base64-encoded 32-byte key).
ANDROID_API_URL=https://192.168.1.100:8443
ANDROID_API_TOKEN=
ANDROID_CLIENT_ID=integration-test
